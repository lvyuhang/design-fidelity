# Optional local settings. Copy to .env.local; never commit credentials.
# project.py parses literal KEY=value lines; it does not execute shell code.
# FLUTTER_ROOT=/absolute/path/to/flutter
# LANHU_COOKIE=fill-your-own-cookie-locally
# LANHU_MCP_LAUNCHER=/absolute/path/to/lanhu-mcp/run-local-mcp.sh
# LANHU_CLIENT_PYTHON=/absolute/path/to/python-with-mcp
# REVIEW_ADB=/absolute/path/to/adb
# REVIEW_DATA_DIR=/absolute/path/to/your-review-data
