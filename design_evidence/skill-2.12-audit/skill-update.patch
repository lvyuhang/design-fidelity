+def source_text_detector(node):
+    """Single opaque source color only; never guess from candidate/reference ink."""
+    spec = node.get('text_spec') or {}
+    runs = spec.get('text_runs') or [spec.get('base_style') or {}]
+    colors = {r.get('color') for r in runs}
+    if len(colors) != 1:
+        return None
+    color = next(iter(colors))
+    if not isinstance(color, str):
+        return None
+    if re.fullmatch(r'#[0-9a-fA-F]{6}', color):
+        rgb = [int(color[i:i+2], 16) for i in (1,3,5)]
+    else:
+        match = re.fullmatch(r'rgba\((\d+),(\d+),(\d+),1(?:\.0+)?\)', color.replace(' ', ''))
+        if not match:
+            return None
+        rgb = list(map(int, match.groups()))
+    if any(v > 255 for v in rgb):
+        return None
+    return {'kind':'color_distance','rgb':rgb,'max_distance':32,'min_pixels':2}
 
 
